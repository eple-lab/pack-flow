# PackFlow 환경변수 예시 — 이름과 설명만. 값은 절대 적지 않는다.
# 사용법: 이 파일을 .env.local로 복사하고, eple이 팀 비공개 채널로 개별 전달한 값을 채운다.
# .env.local은 .gitignore로 막혀 있다. 키 · 비밀번호를 저장소 · 이슈 · AI 대화에 붙여 넣지 않는다.
# 근거: docs/05-security.md 2절 · D-20 · WU-01 / 구역: eple

# ── Supabase (팀원은 dev 프로젝트 값, 배포 Render는 demo 프로젝트 값) ──
# 프로젝트 주소 (https://<프로젝트ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# 브라우저에 실려도 되는 공개 키(anon 또는 publishable). 권한은 RLS가 막는다
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# dev 프로젝트의 ref. 테스트 계정 스크립트가 "지금 주소가 dev인가"를 확인할 때만 쓴다
SUPABASE_DEV_PROJECT_REF=
# [eple 로컬 전용] 서비스 키 — RLS를 무시하는 만능 키. dev 키만, eple PC의 .env.local에만.
# 팀원 PC · Render · 문서 · AI 대화에 넣지 않는다 (D-20 ①). 팀원은 비워 둔다
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM (D-06) ──
# gemini | ollama | fake  (개발은 ollama, 배포는 gemini, 테스트는 fake)
LLM_PROVIDER=ollama
# 모델 이름 (ollama 예: 팀 공통 모델 — 08 Q-12에서 정함)
LLM_MODEL=
# 로컬 Ollama 주소
OLLAMA_BASE_URL=http://localhost:11434
# Gemini 키 — 서버 전용. 본인 키를 본인 .env.local에만, 배포 키는 eple이 Render에 직접 (D-27)
GEMINI_API_KEY=
# LLM 호출 상한 (P-09: 사용자당 하루 30, 앱 전체 하루 300)
LLM_LIMIT_USER=30
LLM_LIMIT_GLOBAL=300

# ── 화면 개발 ──
# 1이면 api-client가 목 응답을 돌려준다(API가 오기 전 화면 개발용). 0 또는 비움 = 실제 API
NEXT_PUBLIC_USE_MOCK=0

# ── 테스트 (dev 프로젝트의 본인 테스트 계정 2개, P-17) ──
# 주소는 실제 메일이 가지 않는 <아이디>-a@packflow.test 형식, 비밀번호는 개별 전달
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
# E2E 대상 주소 (비우면 http://localhost:3000)
E2E_BASE_URL=
