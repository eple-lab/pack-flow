# PackFlow .gitignore — 구역: eple (docs/06-work-plan.md 1절)
# 근거: D-20 ② (docs/05-security.md 2.1) · WU-01

# 환경변수 — 모든 변형(.env, .env.local, .env.dev, .env.local.txt …)을 막고 예시 파일만 허용
.env*
!.env.example

# 의존성
/node_modules
.pnp
.pnp.*

# Next.js · 빌드
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# 테스트 결과
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# 기타
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
.vercel
.vscode/*
!.vscode/extensions.json
.idea/

# 개인 메모 · 로컬 도구 설정
.claude/settings.local.json
